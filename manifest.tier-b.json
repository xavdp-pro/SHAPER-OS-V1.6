{
  "$schema": "./software/schemas/universe-manifest.schema.json",
  "universe": "univX",
  "description": "Public install: local stack + Helm /console + Cloudflare tunnel + voice",
  "intent": "./INTENT.md",
  "agentDeploy": "./AGENT-DEPLOY.md",
  "shaperOs": "./software",

  "bricks": {
    "vault": {
      "ref": "./software/bricks/brick-vault",
      "package": "@shaper/vault",
      "role": "Sovereign secret store (8610)",
      "specialize": {
        "bootstrap": "cd software && npm run vault:bootstrap",
        "file": "./software/resources/vault-resources.local.json"
      }
    },
    "logger": {
      "ref": "./software/bricks/brick-logger",
      "package": "@shaper/logger",
      "role": "Audit JSONL (8620)"
    },
    "bridge-opencode": {
      "ref": "./software/bricks/brick-bridge-opencode",
      "package": "@shaper/bridge-opencode",
      "role": "Free OpenCode bridge (4440)"
    },
    "queue": {
      "ref": "./software/bricks/brick-queue",
      "package": "@shaper/queue",
      "role": "Job queue (8640)"
    },
    "maestro": {
      "ref": "./software/bricks/brick-maestro",
      "package": "@shaper/maestro",
      "role": "Scheduler (8630)",
      "specialize": {
        "file": "./tasks/maestro-tasks.podman.json"
      }
    },
    "helm": {
      "ref": "./software/bricks/brick-helm",
      "package": "helm-v2",
      "role": "Operator web console + voice (8650)"
    },
    "tunnel": {
      "ref": "docker.io/cloudflare/cloudflared:latest",
      "role": "Zero Trust tunnel → public HTTPS",
      "specialize": {
        "how": "Token in ./sav/tunnel/token — Cloudflare dashboard",
        "file": "./sav/tunnel/token"
      }
    }
  },

  "resources": {
    "vaultBootstrap": "./software/resources/vault-resources.local.json",
    "maestroTasks": "./tasks/maestro-tasks.podman.json",
    "agentContext": "./context/AGENT-CONTEXT.md",
    "tunnelToken": "./sav/tunnel/token"
  },

  "bootOrder": [
    ["vault", "logger"],
    ["bridge-opencode"],
    ["queue"],
    ["maestro"],
    ["helm", "tunnel"]
  ],

  "requiredAccounts": {
    "cloudflare": "Domain DNS + Zero Trust tunnel token",
    "deepgram": "STT + TTS in /console",
    "groq": "Voice ack only",
    "opencode": "Free models in bridge — no paid key"
  },

  "optionalAccounts": {
    "cloudflareR2": "Cold backups — one bucket + API token",
    "cartesia": "Alternate TTS",
    "elevenlabs": "Alternate TTS",
    "openrouter": "Alternate LLM routing"
  }
}
